@model List<TravelAI.Models.AppUser>
@{
    ViewData["Title"] = "Admin - Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex relative" style="min-height:calc(100vh - 4rem);">
    @await Html.PartialAsync("_AdminSidebar")

    <main class="flex-1 overflow-auto p-4 md:p-8 min-w-0">
        <!-- Mobile header bar -->
        <div class="flex items-center gap-3 mb-5 md:hidden">
            <button onclick="openAdminSidebar()" class="p-2 rounded-lg bg-white/5 border border-white/10 text-gray-300 hover:bg-white/10 transition-colors flex-shrink-0">
                <i class="fa-solid fa-bars text-sm"></i>
            </button>
            <div>
                <h1 class="text-lg font-bold text-white leading-tight">Users</h1>
                <p class="text-gray-500 text-xs">@Model.Count total users</p>
            </div>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
            <div class="hidden md:block">
                <h1 class="text-2xl font-bold text-white">Users</h1>
                <p class="text-gray-400 text-sm mt-1">@Model.Count total users</p>
            </div>
            <form method="get" class="flex gap-2">
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name or email..."
                       class="px-3 py-2 text-sm bg-white/5 border border-white/10 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 w-60" />
                <button type="submit" class="px-3 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm rounded-lg transition-colors whitespace-nowrap">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
                {
                    <a href="/Admin/Users" class="px-3 py-2 bg-white/5 hover:bg-white/10 text-gray-400 text-sm rounded-lg transition-colors">Clear</a>
                }
            </form>
        </div>

        <div class="admin-stat-card !p-0 overflow-x-auto">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="pl-5">User</th>
                        <th>Plan</th>
                        <th>Role</th>
                        <th>Last Login</th>
                        <th>Joined</th>
                        <th>Status</th>
                        <th class="text-right pr-5">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="pl-5 py-8 text-center text-gray-500">No users found.</td></tr>
                    }
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="pl-5">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">@user.FullName.Substring(0, 1).ToUpper()</div>
                                    <div class="min-w-0">
                                        <p class="font-medium">@user.FullName</p>
                                        <p class="text-xs text-gray-500">@user.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (user.IsPremium)
                                {
                                    <span class="admin-badge admin-badge-yellow">Premium</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-gray">Free</span>
                                }
                            </td>
                            <td>
                                @if (user.IsAdmin)
                                {
                                    <span class="admin-badge admin-badge-red">Admin</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-gray">User</span>
                                }
                            </td>
                            <td class="text-gray-400 text-xs whitespace-nowrap">@(user.LastLoginAt?.ToString("MMM dd, yyyy") ?? "Never")</td>
                            <td class="text-gray-400 text-xs whitespace-nowrap">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (user.LockoutEnd.HasValue && user.LockoutEnd > DateTime.UtcNow)
                                {
                                    <span class="admin-badge admin-badge-red">Locked</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-green">Active</span>
                                }
                            </td>
                            <td class="pr-5">
                                <div class="flex items-center justify-end gap-1">
                                    <form method="post" asp-action="TogglePremium" asp-route-id="@user.Id" asp-route-search="@ViewBag.Search">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="@(user.IsPremium ? "Remove Premium" : "Grant Premium")" class="admin-action-btn text-yellow-400 hover:bg-yellow-500/10">
                                            <i class="fa-solid fa-crown text-xs"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-action="ToggleAdmin" asp-route-id="@user.Id" asp-route-search="@ViewBag.Search">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="@(user.IsAdmin ? "Remove Admin" : "Make Admin")" class="admin-action-btn text-purple-400 hover:bg-purple-500/10">
                                            <i class="fa-solid fa-shield-halved text-xs"></i>
                                        </button>
                                    </form>
                                    @if (user.LockoutEnd.HasValue && user.LockoutEnd > DateTime.UtcNow)
                                    {
                                        <form method="post" asp-action="UnlockUser" asp-route-id="@user.Id" asp-route-search="@ViewBag.Search">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" title="Unlock Account" class="admin-action-btn text-green-400 hover:bg-green-500/10">
                                                <i class="fa-solid fa-unlock text-xs"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-action="DeleteUser" asp-route-id="@user.Id" asp-route-search="@ViewBag.Search" onsubmit="return confirm('Delete @Html.Raw(user.FullName.Replace("'", "\\'"))? This cannot be undone.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="Delete User" class="admin-action-btn text-red-400 hover:bg-red-500/10">
                                            <i class="fa-solid fa-trash text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
