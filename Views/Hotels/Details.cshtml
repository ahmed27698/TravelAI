@model TravelAI.Models.Hotel
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pt-16 min-h-screen">
    <div class="relative h-96 overflow-hidden">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?w=1200'" />
        <div class="absolute inset-0" style="background: linear-gradient(to top, #030712 0%, rgba(3,7,18,0.5) 60%, transparent 100%);"></div>
        <div class="absolute bottom-8 left-0 right-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <div class="stars mb-2">@string.Concat(Enumerable.Repeat("★", (int)Model.Stars))</div>
                    <h1 class="text-4xl font-black text-white">@Model.Name</h1>
                    <p class="text-blue-200 mt-2 flex items-center gap-2">
                        <i class="fa-solid fa-location-dot"></i> @Model.Address, @Model.City
                    </p>
                </div>
                <div class="text-right">
                    <div class="text-4xl font-black text-blue-400">$@Model.PricePerNight</div>
                    <div class="text-gray-400 text-sm">per night</div>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-2">
                <div class="glass-card p-6 mb-6">
                    <h2 class="text-xl font-bold text-white mb-4">About This Hotel</h2>
                    <p class="text-gray-300 leading-relaxed">@Model.Description</p>
                </div>
                <div class="glass-card p-6">
                    <h2 class="text-xl font-bold text-white mb-4">Amenities</h2>
                    <div class="grid grid-cols-2 gap-3">
                        @if (Model.HasWifi) { <div class="flex items-center gap-3 text-gray-300"><i class="fa-solid fa-wifi text-blue-400 w-5"></i> Free WiFi</div> }
                        @if (Model.HasPool) { <div class="flex items-center gap-3 text-gray-300"><i class="fa-solid fa-water-ladder text-blue-400 w-5"></i> Swimming Pool</div> }
                        @if (Model.HasSpa) { <div class="flex items-center gap-3 text-gray-300"><i class="fa-solid fa-spa text-blue-400 w-5"></i> Spa & Wellness</div> }
                        @if (Model.IsLuxury) { <div class="flex items-center gap-3 text-gray-300"><i class="fa-solid fa-gem text-amber-400 w-5"></i> Luxury Property</div> }
                        <div class="flex items-center gap-3 text-gray-300"><i class="fa-solid fa-concierge-bell text-blue-400 w-5"></i> 24/7 Concierge</div>
                        <div class="flex items-center gap-3 text-gray-300"><i class="fa-solid fa-car text-blue-400 w-5"></i> Valet Parking</div>
                    </div>
                </div>
            </div>
            <div>
                <div class="glass-card p-6 sticky top-20">
                    <div class="flex items-center gap-2 mb-4">
                        <div class="text-3xl font-black text-blue-400">$@Model.PricePerNight</div>
                        <span class="text-gray-500 text-sm">/ night</span>
                    </div>
                    <div class="flex items-center gap-2 mb-6">
                        <i class="fa-solid fa-star text-amber-400 text-sm"></i>
                        <span class="text-white font-semibold">@Model.Rating</span>
                        <span class="text-gray-500 text-sm">(@Model.ReviewCount reviews)</span>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="btn-primary w-full py-3 justify-center mb-3">
                            <i class="fa-solid fa-calendar-check"></i> Book Now
                        </button>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn-primary w-full py-3 justify-center mb-3 block text-center">
                            <i class="fa-solid fa-lock"></i> Sign In to Book
                        </a>
                    }
                    <a asp-controller="Hotels" asp-action="Index" class="btn-outline w-full py-2.5 justify-center block text-center">
                        <i class="fa-solid fa-arrow-left"></i> Back to Hotels
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
