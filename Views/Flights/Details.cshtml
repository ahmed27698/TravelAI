@model TravelAI.Models.Flight
@{
    ViewData["Title"] = $"{Model.OriginCode} → {Model.DestinationCode}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pt-24 pb-16 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <a asp-action="Index" class="inline-flex items-center gap-2 text-gray-400 hover:text-white mb-8 transition-colors text-sm">
            <i class="fa-solid fa-arrow-left"></i> Back to Flights
        </a>

        <div class="glass-card p-8 mb-6">
            <div class="flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="text-center">
                    <div class="text-5xl font-black text-white">@Model.OriginCode</div>
                    <div class="text-gray-400 mt-1">@Model.Origin</div>
                    <div class="text-2xl font-bold text-blue-300 mt-2">@Model.DepartureTime.ToString("HH:mm")</div>
                    <div class="text-gray-500 text-sm">@Model.DepartureTime.ToString("MMM dd, yyyy")</div>
                </div>
                <div class="flex flex-col items-center gap-2 flex-1">
                    <div class="text-gray-500 text-sm">@(Model.DurationMinutes / 60)h @(Model.DurationMinutes % 60)m</div>
                    <div class="w-full flex items-center gap-2">
                        <div class="flex-1 h-px bg-gradient-to-r from-blue-500 to-blue-300"></div>
                        <i class="fa-solid fa-plane text-blue-400 text-xl"></i>
                        <div class="flex-1 h-px bg-gradient-to-r from-blue-300 to-blue-500"></div>
                    </div>
                    @if (Model.IsDirectFlight)
                    {
                        <span class="badge-direct">Direct Flight</span>
                    }
                    else
                    {
                        <span class="text-gray-500 text-xs">With stops</span>
                    }
                </div>
                <div class="text-center">
                    <div class="text-5xl font-black text-white">@Model.DestinationCode</div>
                    <div class="text-gray-400 mt-1">@Model.Destination</div>
                    <div class="text-2xl font-bold text-blue-300 mt-2">@Model.ArrivalTime.ToString("HH:mm")</div>
                    <div class="text-gray-500 text-sm">@Model.ArrivalTime.ToString("MMM dd, yyyy")</div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div class="glass-card p-6">
                <h3 class="text-white font-bold mb-4">Flight Details</h3>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between"><span class="text-gray-500">Airline</span><span class="text-white">@Model.Airline (@Model.AirlineCode)</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Class</span><span class="text-white">@Model.Class</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Seats Available</span><span class="text-white">@Model.SeatsAvailable</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Flight Type</span><span class="text-white">@(Model.IsDirectFlight ? "Direct" : "With Stops")</span></div>
                </div>
            </div>
            <div class="glass-card p-6 flex flex-col justify-between">
                <div>
                    <p class="text-gray-400 text-sm mb-2">Price per person</p>
                    <div class="text-5xl font-black text-blue-400">$@Model.Price</div>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="btn-primary py-3 justify-center mt-4">
                        <i class="fa-solid fa-ticket"></i> Book This Flight
                    </button>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-primary py-3 justify-center mt-4 block text-center">
                        <i class="fa-solid fa-lock"></i> Sign In to Book
                    </a>
                }
            </div>
        </div>
    </div>
</div>
