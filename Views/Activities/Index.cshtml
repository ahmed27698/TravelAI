@model List<TravelAI.Models.Activity>
@{
    ViewData["Title"] = "Activities";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cats = ViewBag.Categories as List<string> ?? new();
    var countries = ViewBag.Countries as List<TravelAI.Models.Country> ?? new();
    var currentCat = Context.Request.Query["category"].ToString();
}

<div class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
            <div class="section-badge"><i class="fa-solid fa-compass"></i> <span data-i18n="activities.badge">Experiences</span></div>
            <h1 class="section-title mt-3"><span data-i18n="activities.title1">Discover</span> <span class="gradient-text" data-i18n="activities.title2">Activities</span></h1>
        </div>

        <!-- Category tabs -->
        <div class="flex flex-wrap gap-2 justify-center mb-8">
            <a href="@Url.Action("Index")" class="flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-medium transition-all @(string.IsNullOrEmpty(currentCat) ? "bg-blue-600 text-white" : "border border-white/10 text-gray-400 hover:border-blue-500/50 hover:text-blue-400")">
                <span data-i18n="activities.all">All</span>
            </a>
            @foreach (var cat in cats)
            {
                <a href="@Url.Action("Index", new { category = cat })" class="flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-medium transition-all @(currentCat == cat ? "bg-blue-600 text-white" : "border border-white/10 text-gray-400 hover:border-blue-500/50 hover:text-blue-400")">
                    @cat
                </a>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-24">
                <i class="fa-solid fa-compass text-6xl text-gray-700 mb-6 block"></i>
                <p class="text-gray-400 text-lg" data-i18n="activities.no_results">No activities found.</p>
            </div>
        }
        else
        {
            <div class="stagger-cards grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var activity in Model)
                {
                    <a asp-action="Details" asp-route-id="@activity.Id" class="stagger-card activity-card block">
                        <div class="relative overflow-hidden">
                            <img src="@activity.ImageUrl" alt="@activity.Name" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=800'" />
                            <div class="absolute top-3 left-3">
                                <span class="cat-badge">@activity.Category</span>
                            </div>
                        </div>
                        <div class="p-4">
                            <h3 class="text-white font-bold">@activity.Name</h3>
                            <p class="text-gray-500 text-sm mt-1 flex items-center gap-1">
                                <i class="fa-solid fa-location-dot text-xs"></i> @activity.City
                                @(activity.Country != null ? ", " + activity.Country.Name : "")
                            </p>
                            <div class="flex items-center justify-between mt-3">
                                <span class="text-blue-400 font-black text-xl">$@activity.Price<span class="text-gray-500 text-xs font-normal ml-1">/ person</span></span>
                                <div class="flex items-center gap-3 text-sm">
                                    <span class="text-gray-500 flex items-center gap-1"><i class="fa-regular fa-clock text-xs"></i> @activity.DurationHours h</span>
                                    <span class="text-amber-400 flex items-center gap-1"><i class="fa-solid fa-star text-xs"></i> @activity.Rating</span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
