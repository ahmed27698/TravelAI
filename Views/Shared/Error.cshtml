@model TravelAI.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center px-4 pt-20">
    <div class="text-center max-w-md">
        <div class="w-20 h-20 rounded-2xl bg-red-500/10 border border-red-500/30 flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-triangle-exclamation text-red-400 text-3xl"></i>
        </div>
        <h1 class="text-3xl font-bold text-white mb-3">Something went wrong</h1>
        <p class="text-gray-400 mb-6">An error occurred while processing your request.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="text-gray-600 text-xs mb-6">Request ID: <code class="text-gray-500">@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn-primary px-8 py-3">
            <i class="fa-solid fa-house"></i> Back to Home
        </a>
    </div>
</div>
