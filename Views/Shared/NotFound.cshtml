@{
    ViewData["Title"] = "Page Not Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center px-4 pt-20" style="background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(37,99,235,0.12) 0%, transparent 60%), #030712;">
    <div class="text-center max-w-lg">
        <div class="relative mb-8">
            <div class="text-9xl font-black text-white/5 select-none leading-none">404</div>
            <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-24 h-24 rounded-3xl bg-gradient-to-br from-blue-500/20 to-purple-600/20 border border-blue-500/30 flex items-center justify-center">
                    <i class="fa-solid fa-map-location-dot text-4xl text-blue-400"></i>
                </div>
            </div>
        </div>
        <h1 class="text-3xl font-bold text-white mb-3">Destination Not Found</h1>
        <p class="text-gray-400 mb-8 leading-relaxed">
            Looks like this page got lost somewhere between takeoff and landing. Let's get you back on track.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
            <a asp-controller="Home" asp-action="Index" class="btn-primary px-6 py-3">
                <i class="fa-solid fa-house"></i> Back to Home
            </a>
            <a asp-controller="Countries" asp-action="Index" class="btn-outline px-6 py-3">
                <i class="fa-solid fa-earth-americas"></i> Explore Destinations
            </a>
        </div>
    </div>
</div>
