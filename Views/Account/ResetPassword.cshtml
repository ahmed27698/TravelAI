@model TravelAI.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center px-4 pt-20 pb-12" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(37,99,235,0.15) 0%, transparent 70%), #030712;">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 mb-6">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center">
                    <i class="fa-solid fa-plane text-white"></i>
                </div>
                <span class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-blue-200 bg-clip-text text-transparent">TravelAI</span>
            </a>
            <div class="w-16 h-16 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-lock-open text-blue-400 text-2xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-white">Set new password</h1>
            <p class="text-gray-400 mt-2 text-sm">Choose a strong password for your account.</p>
        </div>

        <div class="glass-card p-8">
            <div asp-validation-summary="All" class="validation-summary-errors mb-4"></div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Token" type="hidden" />

                <div class="space-y-5">
                    <div>
                        <label asp-for="NewPassword" class="block text-sm font-medium text-gray-300 mb-1.5">New Password</label>
                        <div class="relative">
                            <i class="fa-solid fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
                            <input asp-for="NewPassword" class="auth-input" type="password" placeholder="Min. 8 characters" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-300 mb-1.5">Confirm New Password</label>
                        <div class="relative">
                            <i class="fa-solid fa-shield-check absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
                            <input asp-for="ConfirmPassword" class="auth-input" type="password" placeholder="Repeat your password" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <!-- Password strength hint -->
                    <div class="flex items-center gap-2 text-xs text-gray-500">
                        <i class="fa-solid fa-circle-info text-blue-400"></i>
                        Use at least 8 characters with a mix of letters and numbers.
                    </div>

                    <button type="submit" class="btn-primary w-full py-3.5 text-base justify-center">
                        <i class="fa-solid fa-check"></i>
                        Update Password
                    </button>
                </div>
            </form>
        </div>

        <div class="text-center mt-6">
            <a asp-controller="Account" asp-action="Login" class="text-gray-600 hover:text-gray-400 text-sm transition-colors flex items-center justify-center gap-2">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Sign In
            </a>
        </div>
    </div>
</div>
