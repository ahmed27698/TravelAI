@{
    ViewData["Title"] = "Check Your Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var email = TempData["ResetEmail"]?.ToString() ?? "your email";
    var token = TempData["ResetToken"]?.ToString();
}

<div class="min-h-screen flex items-center justify-center px-4 pt-20 pb-12" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(37,99,235,0.15) 0%, transparent 70%), #030712;">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 mb-6">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center">
                    <i class="fa-solid fa-plane text-white"></i>
                </div>
                <span class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-blue-200 bg-clip-text text-transparent">TravelAI</span>
            </a>

            <div class="w-20 h-20 rounded-2xl bg-green-500/10 border border-green-500/20 flex items-center justify-center mx-auto mb-5">
                <i class="fa-solid fa-envelope-circle-check text-green-400 text-3xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-white">Check your inbox</h1>
            <p class="text-gray-400 mt-2 text-sm">
                If an account exists for <strong class="text-gray-300">@email</strong>,<br />a password reset link has been sent.
            </p>
        </div>

        <div class="glass-card p-8 space-y-4">
            <div class="flex items-start gap-3 text-sm text-gray-400">
                <i class="fa-solid fa-circle-info text-blue-400 mt-0.5 flex-shrink-0"></i>
                <p>The link will expire in <strong class="text-gray-300">1 hour</strong>. Check your spam folder if you don't see the email.</p>
            </div>

            @if (!string.IsNullOrEmpty(token))
            {
                <div class="border border-amber-500/30 rounded-xl p-4 bg-amber-500/5">
                    <p class="text-xs text-amber-400 font-semibold mb-2 flex items-center gap-1.5">
                        <i class="fa-solid fa-flask"></i> Demo mode — email delivery not configured
                    </p>
                    <p class="text-xs text-gray-400 mb-3">In production, the link below would be sent via email. For now, use it directly:</p>
                    <a asp-controller="Account" asp-action="ResetPassword" asp-route-token="@token"
                       class="block w-full text-center btn-primary py-2.5 text-sm">
                        <i class="fa-solid fa-lock-open mr-1"></i> Reset My Password
                    </a>
                </div>
            }

            <a asp-controller="Account" asp-action="ForgotPassword" class="block text-center text-sm text-blue-400 hover:text-blue-300 transition-colors pt-2">
                <i class="fa-solid fa-rotate-left mr-1"></i> Didn't receive it? Try again
            </a>
        </div>

        <div class="text-center mt-6">
            <a asp-controller="Account" asp-action="Login" class="text-gray-600 hover:text-gray-400 text-sm transition-colors flex items-center justify-center gap-2">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Sign In
            </a>
        </div>
    </div>
</div>
