@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center px-4 pt-20 pb-12" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(37,99,235,0.15) 0%, transparent 70%), #030712;">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 mb-6">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center">
                    <i class="fa-solid fa-plane text-white"></i>
                </div>
                <span class="text-2xl font-bold bg-gradient-to-r from-blue-400 to-blue-200 bg-clip-text text-transparent">TravelAI</span>
            </a>
            <div class="w-16 h-16 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-key text-blue-400 text-2xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-white">Forgot your password?</h1>
            <p class="text-gray-400 mt-2 text-sm">No worries — enter your email and we'll send you a reset link.</p>
        </div>

        <div class="glass-card p-8">

            @if (TempData["ResetError"] != null)
            {
                <div class="flex items-center gap-3 bg-red-500/10 border border-red-500/30 rounded-xl p-4 mb-6">
                    <i class="fa-solid fa-circle-exclamation text-red-400"></i>
                    <p class="text-red-300 text-sm">@TempData["ResetError"]</p>
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="flex items-center gap-3 bg-red-500/10 border border-red-500/30 rounded-xl p-4 mb-6">
                    <i class="fa-solid fa-circle-exclamation text-red-400"></i>
                    <p class="text-red-300 text-sm">@ViewBag.Error</p>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1.5">Email address</label>
                        <div class="relative">
                            <i class="fa-solid fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
                            <input name="email" type="email" class="auth-input" placeholder="you@example.com" required autocomplete="email" />
                        </div>
                    </div>
                    <button type="submit" class="btn-primary w-full py-3.5 text-base justify-center">
                        <i class="fa-solid fa-paper-plane"></i>
                        Send Reset Link
                    </button>
                </div>
            </form>
        </div>

        <div class="text-center mt-6">
            <a asp-controller="Account" asp-action="Login" class="text-gray-600 hover:text-gray-400 text-sm transition-colors flex items-center justify-center gap-2">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Sign In
            </a>
        </div>
    </div>
</div>
