@model TravelAI.Models.Country
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pt-16 min-h-screen">
    <!-- Hero Banner -->
    <div class="relative h-80 overflow-hidden">
        <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover" onerror="this.src='https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=1200'" />
        <div class="absolute inset-0" style="background: linear-gradient(to top, #030712 0%, rgba(3,7,18,0.6) 50%, rgba(3,7,18,0.2) 100%);"></div>
        <div class="absolute bottom-8 left-0 right-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="section-badge w-fit"><i class="fa-solid fa-earth-americas"></i> @Model.Continent</div>
            <h1 class="text-4xl md:text-5xl font-black text-white mt-2">@Model.Name</h1>
            <p class="text-blue-200 mt-1">@Model.Description</p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-12">
            <div class="glass-card p-5 text-center">
                <div class="text-2xl font-black text-blue-400">$@((int)Model.AverageBudgetPerDay)</div>
                <p class="text-gray-500 text-sm mt-1">Avg. per day</p>
            </div>
            <div class="glass-card p-5 text-center">
                <div class="text-2xl font-black text-blue-400">@Model.Hotels.Count</div>
                <p class="text-gray-500 text-sm mt-1">Hotels listed</p>
            </div>
            <div class="glass-card p-5 text-center">
                <div class="text-2xl font-black text-blue-400">@Model.Activities.Count</div>
                <p class="text-gray-500 text-sm mt-1">Activities</p>
            </div>
        </div>

        <!-- Hotels -->
        @if (Model.Hotels.Any())
        {
            <div class="mb-12">
                <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
                    <i class="fa-solid fa-hotel text-blue-400"></i> Hotels in @Model.Name
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var hotel in Model.Hotels.Take(6))
                    {
                        <a asp-controller="Hotels" asp-action="Details" asp-route-id="@hotel.Id" class="hotel-card block">
                            <div class="relative overflow-hidden">
                                <img src="@hotel.ImageUrl" alt="@hotel.Name" class="w-full h-48 object-cover" onerror="this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800'" />
                            </div>
                            <div class="p-4">
                                <h3 class="text-white font-bold">@hotel.Name</h3>
                                <p class="text-gray-500 text-sm mt-1">@hotel.City</p>
                                <div class="flex items-center justify-between mt-3">
                                    <span class="text-blue-400 font-black text-lg">$@hotel.PricePerNight<span class="text-gray-500 text-xs font-normal">/night</span></span>
                                    <div class="flex items-center gap-1">
                                        <i class="fa-solid fa-star text-amber-400 text-xs"></i>
                                        <span class="text-sm text-white font-medium">@hotel.Rating</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Activities -->
        @if (Model.Activities.Any())
        {
            <div>
                <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
                    <i class="fa-solid fa-compass text-blue-400"></i> Activities in @Model.Name
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var activity in Model.Activities.Take(6))
                    {
                        <a asp-controller="Activities" asp-action="Details" asp-route-id="@activity.Id" class="activity-card block">
                            <div class="relative overflow-hidden">
                                <img src="@activity.ImageUrl" alt="@activity.Name" class="w-full h-44 object-cover" onerror="this.src='https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=800'" />
                            </div>
                            <div class="p-4">
                                <h3 class="text-white font-bold">@activity.Name</h3>
                                <div class="flex items-center justify-between mt-2">
                                    <span class="text-blue-400 font-black">$@activity.Price</span>
                                    <span class="cat-badge">@activity.Category</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>
