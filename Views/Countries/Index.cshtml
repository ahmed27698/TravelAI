@model List<TravelAI.Models.Country>
@{
    ViewData["Title"] = "Explore Countries";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pt-24 pb-16 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <div class="text-center mb-12">
            <div class="section-badge"><i class="fa-solid fa-earth-americas"></i> <span data-i18n="countries.badge">Destinations</span></div>
            <h1 class="section-title mt-3"><span data-i18n="countries.title1">Explore</span> <span class="gradient-text" data-i18n="countries.title2">Countries</span></h1>
            <p class="text-gray-400 mt-3 max-w-xl mx-auto" data-i18n="countries.subtitle">Discover @Model.Count incredible destinations around the world.</p>
        </div>

        <!-- Countries Grid -->
        <div class="stagger-cards grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
            @foreach (var country in Model)
            {
                <a asp-action="Details" asp-route-id="@country.Id" class="stagger-card country-card block group">
                    <img src="@country.ImageUrl" alt="@country.Name" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=800'" />
                    <div class="country-card-overlay">
                        <div class="flex items-center justify-between">
                            <div>
                                <h3 class="text-white font-bold text-base">@country.Name</h3>
                                <p class="text-blue-200 text-xs mt-0.5">@country.Continent</p>
                            </div>
                            <span class="text-xs font-semibold text-amber-300 bg-amber-500/20 px-2 py-1 rounded-lg whitespace-nowrap">
                                $@((int)country.AverageBudgetPerDay)/day
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
</div>
